<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connection Planner – Freundschaften mit System pflegen</title>
    <meta
      name="description"
      content="Der Connection Planner hilft dir, Freundschaften mit derselben Hingabe zu pflegen wie dein Business oder deine Routinen. Trag dich in die Warteliste ein."
    />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin="anonymous"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #faf9f6;
        --card: #fffdf9;
        --text-primary: #2c2c2c;
        --text-secondary: #6b6b6b;
        --accent: #7c9a6e;
        --accent-strong: #5f7d55;
        --accent-muted: #e8e4df;
        --line: #d9d3cb;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
        background: var(--bg);
        color: var(--text-primary);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 32px 20px 120px;
      }

      section {
        padding: 72px 0;
      }

      .hero {
        display: grid;
        gap: 48px;
        align-items: center;
        padding-top: 40px;
      }

      .hero-copy h1 {
        font-family: "Fraunces", "Times New Roman", serif;
        font-size: clamp(2.6rem, 6vw, 4.1rem);
        margin: 16px 0;
        letter-spacing: -0.02em;
      }

      .hero-copy p {
        font-size: 1.15rem;
        color: var(--text-secondary);
        margin: 0 0 24px;
        max-width: 540px;
      }

      .eyebrow {
        letter-spacing: 0.4em;
        text-transform: uppercase;
        font-size: 0.85rem;
        color: var(--text-secondary);
      }

      .hero-cta {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
      }

      .cta-button {
        border: none;
        background: var(--accent);
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        padding: 16px 32px;
        border-radius: 999px;
        cursor: pointer;
        min-height: 48px;
        letter-spacing: 0.03em;
        transition: transform 220ms ease, box-shadow 220ms ease,
          background 220ms ease;
      }

      .cta-button:focus-visible {
        outline: 3px solid rgba(124, 154, 110, 0.4);
        outline-offset: 4px;
      }

      .cta-button:hover {
        transform: translateY(-2px);
        background: var(--accent-strong);
        box-shadow: 0 12px 24px rgba(124, 154, 110, 0.28);
      }

      .microcopy {
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      .hero-visual {
        background: linear-gradient(180deg, #f3efe7, #fefdf9);
        border-radius: 32px;
        padding: 32px;
        position: relative;
        overflow: hidden;
        min-height: 360px;
      }

      .hero-visual::before,
      .hero-visual::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        opacity: 0.35;
      }

      .hero-visual::before {
        width: 360px;
        height: 360px;
        background: var(--accent-muted);
        top: -60px;
        left: -80px;
      }

      .hero-visual::after {
        width: 280px;
        height: 280px;
        background: #d7e3d0;
        bottom: -120px;
        right: -40px;
      }

      .hero-visual svg {
        position: relative;
        width: 100%;
        height: 100%;
      }

      .eyebrow + h2,
      h2.section-title {
        font-family: "Fraunces", "Times New Roman", serif;
        font-size: clamp(2rem, 4vw, 3rem);
        margin: 16px 0;
      }

      .section-copy {
        max-width: 720px;
        color: var(--text-secondary);
        font-size: 1.05rem;
        margin-bottom: 32px;
      }

      .mirror-body p {
        margin: 12px 0;
        font-size: 1.1rem;
      }

      .plant-duo {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-top: 32px;
      }

      .plant {
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 24px;
        background: #fff;
        min-height: 220px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
      }

      .plant svg {
        width: 100%;
        height: 140px;
      }

      .plant-label {
        text-align: center;
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin-top: 16px;
        letter-spacing: 0.05em;
      }

      .pillars {
        display: grid;
        gap: 24px;
      }

      .pillar {
        background: var(--card);
        border-radius: 28px;
        padding: 24px;
        border: 1px solid rgba(44, 44, 44, 0.08);
      }

      .pillar strong {
        font-family: "Fraunces", "Times New Roman", serif;
        display: block;
        font-size: 1.3rem;
        margin-bottom: 12px;
      }

      .quote {
        border-left: 2px solid var(--accent);
        padding-left: 20px;
        font-style: italic;
        font-size: 1.2rem;
        color: var(--text-secondary);
        margin-top: 32px;
      }

      .quote span {
        display: block;
        margin-top: 16px;
        font-size: 0.95rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-secondary);
      }

      .proof-card {
        background: var(--card);
        border-radius: 32px;
        padding: 32px;
        border: 1px solid rgba(44, 44, 44, 0.08);
        display: grid;
        gap: 18px;
      }

      .counter {
        display: flex;
        align-items: baseline;
        gap: 12px;
      }

      #waitlist-count {
        font-size: 2.8rem;
        font-family: "Fraunces", "Times New Roman", serif;
        color: var(--accent-strong);
      }

      .counter-label {
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--text-secondary);
      }

      .waitlist {
        padding-bottom: 80px;
      }

      .waitlist-card {
        background: #ffffff;
        border-radius: 40px;
        padding: 48px;
        border: 1px solid rgba(44, 44, 44, 0.06);
        box-shadow: 0 40px 80px rgba(34, 40, 34, 0.08);
      }

      .waitlist-card h2 {
        font-family: "Fraunces", "Times New Roman", serif;
        font-size: clamp(2.2rem, 4vw, 3rem);
        margin: 0 0 12px;
      }

      .waitlist-card p {
        margin: 0 0 24px;
        color: var(--text-secondary);
        font-size: 1.05rem;
      }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 12px;
      }

      input[type="email"] {
        flex: 1 1 260px;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 16px 20px;
        font-size: 1rem;
        min-height: 52px;
        background: #fff;
        transition: border 180ms ease, box-shadow 180ms ease;
      }

      input[type="email"]:focus-visible {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(124, 154, 110, 0.25);
      }

      .submit-button {
        padding: 16px 32px;
        border-radius: 999px;
        border: none;
        background: var(--text-primary);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        min-height: 52px;
        cursor: pointer;
        transition: transform 220ms ease, background 220ms ease,
          box-shadow 220ms ease;
      }

      .submit-button:hover {
        transform: translateY(-2px);
        background: #1f1f1f;
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
      }

      .waitlist[data-state="success"] .default-state {
        display: none;
      }

      .waitlist[data-state="success"] .success-state {
        display: block;
      }

      .success-state {
        display: none;
      }

      footer {
        max-width: 1080px;
        margin: 0 auto;
        padding: 40px 20px 80px;
        border-top: 1px solid rgba(44, 44, 44, 0.08);
        text-align: center;
        color: var(--text-secondary);
      }

      .logo {
        font-family: "Fraunces", "Times New Roman", serif;
        font-size: 1.1rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        display: block;
        margin-bottom: 12px;
        color: var(--text-primary);
      }

      .legal-links {
        display: inline-flex;
        gap: 12px;
        font-size: 0.9rem;
      }

      .legal-links a {
        color: var(--text-secondary);
        text-decoration: none;
      }

      .legal-links a:hover {
        text-decoration: underline;
      }

      .fade-in {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 600ms ease, transform 600ms ease;
      }

      .fade-in.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
      }

      @media (max-width: 768px) {
        main {
          padding-top: 16px;
        }

        section {
          padding: 56px 0;
        }

        .hero {
          padding-top: 0;
        }

        .waitlist-card {
          padding: 32px 24px;
        }

        form {
          flex-direction: column;
        }
      }

      @media (min-width: 1200px) {
        .hero {
          grid-template-columns: 1.1fr 0.9fr;
        }

        .pillars {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .fade-in,
        .cta-button,
        .submit-button {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero fade-in" id="top">
        <div class="hero-copy">
          <p class="eyebrow">Connection Planner</p>
          <h1>Deine Freundschaften verdienen ein System.</h1>
          <p>
            Der Connection Planner hilft dir, die Menschen zu pflegen, die wirklich
            zählen – mit Struktur, Tiefe und kleinen Gesten. Kein Overload, nur ein
            Ritual, das dich erinnert: Nähe ist eine Entscheidung.
          </p>
          <div class="hero-cta">
            <button class="cta-button" type="button" data-scroll="#waitlist">
              Auf die Warteliste
            </button>
            <p class="microcopy">Kostenlos. Kein Spam. Du erfährst als Erste/r vom Launch.</p>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 400 320" role="presentation">
            <path
              d="M210 300c0-40 40-72 40-120 0-48-32-72-32-112"
              fill="none"
              stroke="#7c9a6e"
              stroke-width="3"
              stroke-linecap="round"
            />
            <path
              d="M170 300c0-32-56-64-56-112s48-72 48-120"
              fill="none"
              stroke="#b8c7b1"
              stroke-width="3"
              stroke-linecap="round"
            />
            <circle cx="248" cy="60" r="18" fill="#9fb895" />
            <circle cx="144" cy="140" r="14" fill="#d3ddc9" />
            <circle cx="212" cy="196" r="16" fill="#7c9a6e" />
            <rect
              x="90"
              y="260"
              width="220"
              height="28"
              rx="14"
              fill="#e8e4df"
              opacity="0.8"
            />
          </svg>
        </div>
      </section>

      <section id="mirror" class="section fade-in">
        <p class="eyebrow">Hand aufs Herz...</p>
        <div class="mirror-body">
          <p>Wann hast du zuletzt einen Freund angerufen – einfach so?</p>
          <p>
            Nicht weil er Geburtstag hatte. Nicht weil du etwas brauchtest. Sondern
            weil er dir wichtig ist.
          </p>
          <p>
            Wir investieren Stunden in Karriere, Körper, Routinen. Aber die Menschen,
            die uns am meisten bedeuten, rutschen durch. Nicht aus Absicht. Sondern
            weil das Leben laut ist.
          </p>
          <p>Der Connection Planner macht Freundschaft zur Gewohnheit – nicht zum Zufall.</p>
        </div>
        <div class="plant-duo" aria-hidden="true">
          <div class="plant">
            <svg viewBox="0 0 200 140">
              <path
                d="M100 130c0-28-24-34-24-68 0-24 12-40 12-60"
                stroke="#c9beb1"
                stroke-width="4"
                fill="none"
                stroke-linecap="round"
              />
              <path
                d="M88 60c-16-4-28 4-36 22"
                stroke="#dcd2c7"
                stroke-width="4"
                fill="none"
                stroke-linecap="round"
              />
              <circle cx="80" cy="36" r="10" fill="#d9cfc4" />
            </svg>
            <p class="plant-label">Vergessene Verbindung</p>
          </div>
          <div class="plant">
            <svg viewBox="0 0 200 140">
              <path
                d="M100 130c0-32 32-44 32-84 0-24-8-36-8-56"
                stroke="#7c9a6e"
                stroke-width="4"
                fill="none"
                stroke-linecap="round"
              />
              <path
                d="M120 64c18-6 30 6 36 26"
                stroke="#94b083"
                stroke-width="4"
                fill="none"
                stroke-linecap="round"
              />
              <circle cx="116" cy="32" r="12" fill="#9cb78d" />
              <circle cx="150" cy="78" r="10" fill="#b8cbae" />
            </svg>
            <p class="plant-label">Gepflegte Nähe</p>
          </div>
        </div>
      </section>

      <section id="solution" class="section fade-in">
        <p class="eyebrow">Dein emotionales Betriebssystem</p>
        <h2 class="section-title">Freundschaft bekommt Struktur, Tiefe und Rituale.</h2>
        <div class="pillars">
          <div class="pillar">
            <strong>Struktur für das Unstrukturierbare</strong>
            <p>
              Ein Kalender, der nicht Deadlines trackt, sondern Menschen. Erinnerungen
              für Nachrichten, Anrufe, Spaziergänge. Du siehst, wann ihr zuletzt
              gesprochen habt – und was als Nächstes gut tut.
            </p>
          </div>
          <div class="pillar">
            <strong>Tiefe statt Smalltalk</strong>
            <p>
              Kuratierte Fragen öffnen Räume – vom Warm-up bis Deep Talk. Für Abende,
              Roadtrips, die fünf Minuten zwischen Meetings. Gespräche, die wirklich
              nähren.
            </p>
          </div>
          <div class="pillar">
            <strong>Rituale, die bleiben</strong>
            <p>
              Kleine Gewohnheiten, die Nähe verankern: eine Nachricht pro Woche, ein
              Check-in pro Monat, ein Mini-Brief nach besonderen Momenten. Micro-Commitments,
              die groß wirken.
            </p>
          </div>
        </div>
      </section>

      <section id="philosophy" class="section fade-in">
        <p class="eyebrow">Warum das alles?</p>
        <h2 class="section-title">Freundschaft ist kein Zufall. Sie ist eine Entscheidung.</h2>
        <p class="section-copy">
          Inspiriert von den Habit-Prinzipien eines James Clear haben wir ein System
          gebaut, das Verbindung zur Routine macht. Nicht robotisch. Nicht gezwungen.
          Sondern achtsam, warm und menschlich. Weil die Menschen, die dich wirklich
          kennen, dein größter Reichtum sind.
        </p>
        <p class="quote">
          „Jede Woche ein Schritt näher – jede Nachricht zählt.“
          <span>Connection Planner</span>
        </p>
      </section>

      <section id="proof" class="section fade-in">
        <p class="eyebrow">Für Menschen, die bewusst leben.</p>
        <div class="proof-card">
          <p>
            Der Connection Planner ist für alle, die Notion-Templates für ihre Ziele
            nutzen, Atomic Habits gelesen haben und wissen: Die besten Dinge im Leben
            brauchen Pflege.
          </p>
          <p>
            Über bewusste Routinen hinaus erinnert dich der Planner daran, wer du sein
            willst – Freund, Freundin, Mensch mit offenen Armen.
          </p>
          <div class="counter">
            <span id="waitlist-count" data-target="527">0</span>
            <span class="counter-label">auf der Warteliste</span>
          </div>
        </div>
      </section>

      <section id="waitlist" class="section waitlist fade-in" data-state="default">
        <div class="waitlist-card">
          <div class="default-state">
            <h2>Bereit, deinen Garten zu pflegen?</h2>
            <p>
              Trag dich ein und erfahre als Erste/r, wenn der Connection Planner
              verfügbar ist. Du erhältst ruhige Updates – keine Ablenkungen, nur das,
              was Verbindung stärkt.
            </p>
            <form id="waitlist-form" novalidate>
              <label class="sr-only" for="email">Deine E-Mail-Adresse</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Deine E-Mail-Adresse"
                autocomplete="email"
                required
              />
              <button type="submit" class="submit-button">Ich bin dabei</button>
            </form>
            <p class="microcopy">
              Kein Spam. Nur Updates zum Launch. Du kannst dich jederzeit abmelden.
            </p>
          </div>
          <div class="success-state" aria-live="polite">
            <h2>Du bist auf der Liste! 🌱</h2>
            <p>
              Wir melden uns, sobald es losgeht. Bis dahin: Ruf einen Freund an.
              Einfach so.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="fade-in visible">
      <span class="logo">Connection Planner</span>
      <p>Made with ❤️ für echte Verbindungen.</p>
      <div class="legal-links">
        <a href="/impressum" target="_blank" rel="noreferrer noopener">Impressum</a>
        <span>·</span>
        <a href="/datenschutz" target="_blank" rel="noreferrer noopener">Datenschutz</a>
        <span>·</span>
        <a href="https://www.instagram.com" target="_blank" rel="noreferrer noopener"
          >Instagram</a
        >
      </div>
    </footer>

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fadeElements = document.querySelectorAll(".fade-in");

      if (!reduceMotion && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 }
        );

        fadeElements.forEach((el) => observer.observe(el));
      } else {
        fadeElements.forEach((el) => el.classList.add("visible"));
      }

      document.querySelectorAll("[data-scroll]").forEach((button) => {
        button.addEventListener("click", () => {
          const target = document.querySelector(button.dataset.scroll);
          target?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
        });
      });

      const counterEl = document.getElementById("waitlist-count");
      if (counterEl && "IntersectionObserver" in window) {
        const targetValue = parseInt(counterEl.dataset.target, 10) || 0;
        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateCounter(counterEl, targetValue);
                counterObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.4 }
        );
        counterObserver.observe(counterEl);
      } else if (counterEl) {
        counterEl.textContent = counterEl.dataset.target + "+";
      }

      function animateCounter(element, target) {
        const duration = 1200;
        const start = performance.now();

        function tick(now) {
          const progress = Math.min((now - start) / duration, 1);
          const value = Math.floor(progress * target);
          element.textContent = value + "+";
          if (progress < 1) {
            requestAnimationFrame(tick);
          }
        }

        requestAnimationFrame(tick);
      }

      const waitlistSection = document.getElementById("waitlist");
      const waitlistForm = document.getElementById("waitlist-form");

      if (waitlistForm) {
        waitlistForm.addEventListener("submit", (event) => {
          event.preventDefault();
          const emailInput = waitlistForm.querySelector('input[type="email"]');
          if (!emailInput.checkValidity()) {
            emailInput.reportValidity();
            return;
          }

          // Placeholder for backend integration (Mailchimp/ConvertKit/etc.)
          setTimeout(() => {
            waitlistSection?.setAttribute("data-state", "success");
            waitlistForm.reset();
          }, 400);
        });
      }
    </script>
  </body>
</html>
